datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String
  middleName String?
  phone      String   @unique
  email      String   @unique
  password   String
  role       String   @default("USER")
  createdAt  DateTime @default(now())
  reviews    Review[]
}

model Article {
  id           Int      @id @default(autoincrement())
  title        String
  category     String
  authorName   String
  excerpt      String
  coverUrl     String
  authorAvatar String?
  contentJson  String
  createdAt    DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  text      String
  createdAt DateTime @default(now())
}